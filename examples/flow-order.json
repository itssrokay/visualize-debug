   "to": "svc",
   "label": "lockStock(lines)",
   "code": [
    "mall-portal/src/main/java/com/macro/mall/portal/service/impl/OmsPortalOrderServiceImpl.java:165"
   ],
   "detail": "Moves quantity into lock_stock so nobody else can buy it."
  },
  {
   "from": "svc",
   "to": "redis",
   "label": "INCR order sn",
   "code": [
    "mall-portal/src/main/java/com/macro/mall/portal/service/impl/OmsPortalOrderServiceImpl.java:446"
   ],
   "detail": "generateOrderSn: date + source + payType + Redis sequence."
  },
  {
   "from": "svc",
   "to": "mapper",
   "label": "insert(order)"
  },
  {
   "from": "mapper",
   "to": "db",
   "label": "INSERT oms_order",
   "ms": 8
  },
  {
   "from": "svc",
   "to": "mapper",
   "label": "insertList(orderItems)",
   "code": [
    "mall-portal/src/main/java/com/macro/mall/portal/service/impl/OmsPortalOrderServiceImpl.java:229"
   ],
   "detail": "\u26a0 This is the line in the crash tab: a duplicate order_sn blows up here."
  },
  {
   "from": "mapper",
   "to": "db",
   "kind": "slow",
   "label": "INSERT oms_order_item \u00d72",
   "ms": 240
  },
  {
   "from": "svc",
   "to": "mq",
   "kind": "async",
   "label": "cancel order in 60 min",
   "detail": "sendDelayMessageCancelOrder \u2192 RabbitMQ delayed queue."
  },
  {
   "from": "svc",
   "to": "ctrl",
   "kind": "return",
   "label": "{order, orderItemList}"
  },
  {
   "from": "ctrl",
   "to": "client",
   "kind": "return",
   "label": "200 CommonResult.success"
