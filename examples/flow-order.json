   "code": [
    "mall-portal/src/main/java/com/macro/mall/portal/controller/OmsPortalOrderController.java:43"
   ]
  },
  {
   "from": "ctrl",
   "to": "svc",
   "label": "generateOrder(orderParam)",
   "code": [
    "mall-portal/src/main/java/com/macro/mall/portal/service/impl/OmsPortalOrderServiceImpl.java:94"
   ]
  },
  {
   "from": "svc",
   "to": "member",
   "label": "getCurrentMember()",
   "detail": "Who is checking out (from the JWT in the security context)."
  },
