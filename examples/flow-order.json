   "from": "cart",
   "to": "svc",
   "kind": "return",
   "label": "2 priced cart lines"
  },
  {
   "from": "svc",
   "to": "svc",
   "label": "hasStock() \u2192 else throw",
   "code": [
    "mall-portal/src/main/java/com/macro/mall/portal/service/impl/OmsPortalOrderServiceImpl.java:124"
   ],
   "detail": "If any line has no stock left, the order fails here with 'stock not enough'."
  },
  {
   "from": "svc",
   "to": "svc",
   "label": "coupon + points + totals",
   "code": [
    "mall-portal/src/main/java/com/macro/mall/portal/service/impl/OmsPortalOrderServiceImpl.java:135"
   ],
   "detail": "getUseCoupon, handleCouponAmount, calcTotalAmount, calcPayAmount\u2026"
  },
  {
