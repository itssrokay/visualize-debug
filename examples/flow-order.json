  {
   "id": "mapper",
   "label": "Order mappers",
   "kind": "repo",
   "module": "mall-mbg",
   "note": "MyBatis generated mappers + PortalOrderItemDao"
  },
  {
   "id": "db",
   "label": "MySQL",
   "kind": "db"
  },
  {
   "id": "mq",
   "label": "RabbitMQ",
   "kind": "queue",
   "note": "Delayed message: cancels the order if it is still unpaid after the timeout."
  }
 ],
 "steps": [
  {
   "from": "client",
   "to": "ctrl",
   "label": "POST /order/generateOrder",
   "payload": {
    "cartIds": [
     12,
     13
    ],
    "couponId": 4,
    "useIntegration": 0,
    "payType": 1,
    "memberReceiveAddressId": 7
