{
 "id": "generate-order",
 "tab": "Flow: place order",
 "title": "Placing an order",
 "subtitle": "POST /order/generateOrder \u00b7 mall-portal",
 "description": "What happens when a shopper checks out their cart: price it, lock stock, write the order, then schedule an auto-cancel.",
 "nodes": [
  {
