   "kind": "controller",
   "module": "mall-portal",
   "files": [
    "mall-portal/src/main/java/com/macro/mall/portal/controller/OmsPortalOrderController.java"
   ]
  },
  {
   "id": "svc",
   "label": "OmsPortalOrderService",
   "kind": "service",
   "module": "mall-portal",
   "files": [
    "mall-portal/src/main/java/com/macro/mall/portal/service/impl/OmsPortalOrderServiceImpl.java"
   ],
   "note": "Owns the whole checkout. 700+ lines; most of it is price maths."
  },
  {
   "id": "member",
   "label": "UmsMemberService",
   "kind": "service",
   "module": "mall-portal"
  },
